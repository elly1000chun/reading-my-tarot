{
  "type": "module",
  "name": "@MarketingPipeline/Tarot.js",
  "version": "1.0.0",
  "description": "A powerful and customizable JavaScript library for creating and managing Tarot card decks, custom spreads, and readings.",
  "license": "MIT",
  "main": "./dist/tarot.min.js",
  "browser": "./dist/tarot.umd.min.js",
  "unpkg": "./dist/tarot.umd.min.js",
  "exports": {
    ".": {
      "import": "./dist/tarot.min.js",
      "require": "./dist/tarot.min.cjs"
    }
  },
  "author": {
    "name": "MarketingPipeline",
    "url": "https://github.com/MarketingPipeline"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MarketingPipeline/Tarot.js.git"
  },
  "scripts": {
    "build": "webpack --config ./src/webpack.config.js",
    "test": "vitest run test",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:update": "playwright test --update-snapshots",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@babel/core": "^7.24.8",
    "@babel/preset-env": "^7.24.8",
    "@babel/register": "^7.12.10",
    "@playwright/test": "^1.61.0",
    "babel-loader": "^9.1.3",
    "core-js": "^3.45.1",
    "http-server": "^14.1.1",
    "terser-webpack-plugin": "^5.3.10",
    "vitest": "^4.1.8",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "wrangler": "^4.101.0"
  }
}
